generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum EnrollmentStatus {
  ACTIVE
  PENDING_RENEWAL
  LAPSED
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  CREATED
  SUCCEEDED
  FAILED
  REFUNDED
}

enum CommunicationChannel {
  EMAIL
}

enum MemberDiscipline {
  ARCHERY
  PISTOL
  RIFLE
  TRAP
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  DENIED
}

model Member {
  id                String                 @id @default(uuid())
  name              String
  email             String                 @unique
  passwordHash      String
  phone             String?
  street1           String                 @default("")
  street2           String?
  city              String                 @default("")
  state             String                 @default("")
  zip               String                 @default("")
  dob               DateTime?
  isDisabledVeteran Boolean                @default(false)
  isSenior          Boolean                @default(false)
  isActive          Boolean                @default(true)
  status            MemberStatus           @default(ACTIVE)
  emergencyContactName String?
  emergencyContactPhone String?
  emergencyContactRelationship String?
  disciplineInterests MemberDiscipline[] @default([])
  dlNumberHash      String?
  dlNumberCiphertext String?
  dlNumberIv        String?
  dlNumberAuthTag   String?
  role              Role                   @default(MEMBER)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  householdMembers  HouseholdMember[]
  enrollments          MembershipEnrollment[]
  payments             Payment[]
  createdApplications  MembershipApplication[] @relation("CreatedMemberApplications")
  reviewedApplications MembershipApplication[] @relation("ReviewedApplications")
  communicationLogs CommunicationLog[]
  authoredAuditLogs AuditLog[]             @relation("AuditActor")
  targetedAuditLogs AuditLog[]             @relation("AuditTarget")
}

model HouseholdMember {
  id           String   @id @default(uuid())
  memberId      String
  name          String
  relationship  String
  dob           DateTime?
  under18       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

model MembershipYear {
  id             String   @id @default(uuid())
  year           Int      @unique
  startsAt       DateTime
  endsAt         DateTime
  renewalOpensAt DateTime
  renewalDueAt   DateTime
  membershipCap  Int      @default(350) @map("capacity")
  standardPriceCents Int  @default(15000)
  discountPriceCents Int  @default(10000)
  signupDate     DateTime?
  signupEnabled  Boolean  @default(true)
  applicationEnabled Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  enrollments MembershipEnrollment[]
  payments    Payment[]
  pricingTiers PricingTier[]
  applications MembershipApplication[]
}

model PricingTier {
  id                   String   @id @default(uuid())
  membershipYearId     String
  code                 String
  name                 String
  amountCents          Int
  isActive             Boolean  @default(true)
  isSenior             Boolean  @default(false)
  requiresAdminApproval Boolean @default(true)
  priority             Int      @default(100)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  membershipYear MembershipYear          @relation(fields: [membershipYearId], references: [id], onDelete: Cascade)
  applications   MembershipApplication[]

  @@unique([membershipYearId, code])
  @@index([membershipYearId, isActive])
}

model MembershipApplication {
  id                             String            @id @default(uuid())
  membershipYearId               String
  applicantEmail                 String
  applicantFirstName             String
  applicantLastName              String
  applicantPhone                 String?
  applicantStreet1               String            @default("")
  applicantStreet2               String?
  applicantCity                  String            @default("")
  applicantState                 String            @default("")
  applicantZip                   String            @default("")
  applicantDob                   DateTime?
  status                         ApplicationStatus @default(DRAFT)
  requestedDisabledVeteranDiscount Boolean         @default(false)
  disabledVeteranApproved        Boolean?
  seniorAutoApplied              Boolean           @default(false)
  assignedPricingTierId          String?
  createdMemberId                String?
  submittedAt                    DateTime?
  reviewedAt                     DateTime?
  reviewedByMemberId             String?
  reviewedByEmail                String?
  denialReason                   String?
  createdAt                      DateTime          @default(now())
  updatedAt                      DateTime          @updatedAt

  createdMember      Member?       @relation("CreatedMemberApplications", fields: [createdMemberId], references: [id], onDelete: SetNull)
  reviewedByMember   Member?       @relation("ReviewedApplications", fields: [reviewedByMemberId], references: [id], onDelete: SetNull)
  membershipYear     MembershipYear @relation(fields: [membershipYearId], references: [id], onDelete: Cascade)
  assignedPricingTier PricingTier? @relation(fields: [assignedPricingTierId], references: [id], onDelete: SetNull)

  @@unique([membershipYearId, applicantEmail])
  @@index([membershipYearId, status])
  @@index([reviewedByMemberId])
  @@index([createdMemberId])
}

model MembershipEnrollment {
  id               String           @id @default(uuid())
  memberId         String
  membershipYearId String
  status           EnrollmentStatus @default(PENDING_RENEWAL)
  renewedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  member         Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membershipYear MembershipYear @relation(fields: [membershipYearId], references: [id], onDelete: Cascade)
  payments       Payment[]

  @@unique([memberId, membershipYearId])
  @@index([membershipYearId, status])
}

model Payment {
  id               String          @id @default(uuid())
  provider         PaymentProvider @default(STRIPE)
  amountCents      Int
  status           PaymentStatus   @default(CREATED)
  externalId       String?
  webhookEventId   String?         @unique
  paidAt           DateTime?
  memberId         String
  membershipYearId String
  enrollmentId     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  member         Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membershipYear MembershipYear       @relation(fields: [membershipYearId], references: [id], onDelete: Cascade)
  enrollment     MembershipEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([memberId, membershipYearId])
}

model CommunicationLog {
  id          String               @id @default(uuid())
  channel     CommunicationChannel @default(EMAIL)
  toAddress   String
  subject     String?
  bodyPreview String
  sentAt      DateTime             @default(now())
  memberId    String?
  meta        Json?
  createdAt   DateTime             @default(now())

  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([memberId])
}

model SystemSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id             String   @id @default(uuid())
  action         String
  actorMemberId  String?
  targetMemberId String?
  meta           Json?
  createdAt      DateTime @default(now())

  actorMember  Member? @relation("AuditActor", fields: [actorMemberId], references: [id], onDelete: SetNull)
  targetMember Member? @relation("AuditTarget", fields: [targetMemberId], references: [id], onDelete: SetNull)

  @@index([actorMemberId])
  @@index([targetMemberId])
  @@index([action, createdAt])
}
